{% extends "base.html" %}

{% block content %}
<div class="dashboard-container">
    <h2>Admin Dashboard (HOD View)</h2>

    <div class="dashboard-grid">
        <!-- Stats -->
        <div class="card">
            <h3>System Health</h3>
            <p>Total Users: {{ users|length }}</p>
            <p>At-Risk Students: <strong style="color:red">Detected</strong></p>
            <a href="{{ url_for('admin.export_risk_report') }}" class="btn"
                style="background:#28a745; margin-top:10px;">📥 Download Risk Report</a>
        </div>

        <!-- Faculty Registration (Exclusive to Admin) -->
        <div class="card">
            <h3>Register New Faculty</h3>
            <p class="note">Only Admins can onboard Faculty members.</p>
            <form action="{{ url_for('admin.add_user') }}" method="POST">
                <input type="hidden" name="role" value="faculty">
                <div class="form-group">
                    <input type="text" name="username" placeholder="Faculty Username" required>
                </div>
                <div class="form-group">
                    <input type="password" name="password" placeholder="Password" required>
                </div>
                <div class="form-group">
                    <input type="text" name="subject" placeholder="Assigned Subject (e.g. Cyber Security)" required>
                </div>
                <!-- Optional: Subject/ID fields could be added here if extended further -->
                <button type="submit" class="btn">Create Faculty Account</button>
            </form>
        </div>

        <!-- Class Advisor Registration (New) -->
        <div class="card">
            <h3>Register Class Advisor</h3>
            <p class="note">Assign an Advisor to a Class/Batch.</p>
            <form action="{{ url_for('admin.add_user') }}" method="POST">
                <input type="hidden" name="role" value="class_advisor">
                <div class="form-group">
                    <input type="text" name="username" placeholder="Advisor Username" required>
                </div>
                <div class="form-group">
                    <input type="password" name="password" placeholder="Password" required>
                </div>
                <div class="form-group">
                    <input type="text" name="subject" placeholder="Assigned Class (e.g. Class A)" required>
                </div>
                <button type="submit" class="btn">Create Advisor Account</button>
            </form>
        </div>

        <!-- User Management List -->
        <div class="card full-width">
            <h3>User Management</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>{{ user.username }}</td>
                        <td>{{ user.role }}</td>
                        <td>Active</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</div>
{% endblock %}