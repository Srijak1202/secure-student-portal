{% extends "base.html" %}

{% block content %}
<div class="dashboard-container">
    <h2>Faculty Dashboard</h2>
    <p class="text-muted">Assigned Subject: <strong>{{ current_user.subject or 'Not Assigned' }}</strong></p>

    <div class="dashboard-grid">

        <!-- 1. Assignment Upload -->
        <div class="card">
            <h3>Upload Assignment Marks</h3>
            {% if not current_user.subject %}
            <div class="badge error">No Subject Assigned. Contact Admin.</div>
            {% else %}
            <form action="{{ url_for('faculty.add_assignment') }}" method="POST">

                <div class="form-group">
                    <label>Select Student</label>
                    <input list="students_list" name="student_id" placeholder="Start typing name..." required>
                    <datalist id="students_list">
                        {% for s in students %}
                        <option value="{{ s.id }}">{{ s.username }} - {{ s.full_name }}</option>
                        {% endfor %}
                    </datalist>
                </div>

                <div class="form-group">
                    <label>Assignment Number</label>
                    <input type="number" name="assign_no" placeholder="e.g. 1, 2" required>
                </div>

                <div class="form-group">
                    <label>Marks</label>
                    <div style="display:flex; gap:10px;">
                        <input type="number" name="obt" placeholder="Obtained" required style="width:33%">
                        <input type="number" name="tot" placeholder="Total" required style="width:33%">
                        <input type="number" name="convert_to" placeholder="Convert Max (Opt)" style="width:33%">
                    </div>
                </div>

                <div class="form-group">
                    <label>Remarks</label>
                    <input type="text" name="remarks" placeholder="Optional comments...">
                </div>

                <button type="submit" class="btn">Upload Assignment</button>
            </form>
            {% endif %}
        </div>

        <!-- 2. Evaluation Upload -->
        <div class="card">
            <h3>Upload Evaluation Marks</h3>
            {% if not current_user.subject %}
            <div class="badge error">No Subject Assigned.</div>
            {% else %}
            <form action="{{ url_for('faculty.add_evaluation') }}" method="POST">

                <div class="form-group">
                    <label>Select Student</label>
                    <input list="students_list" name="student_id" placeholder="Start typing name..." required>
                </div>

                <div class="form-group">
                    <label>Evaluation Type</label>
                    <input type="text" name="eval_type" placeholder="e.g. Lab Eval, Class Test, Midterm" required>
                </div>

                <div class="form-group">
                    <label>Marks</label>
                    <div style="display:flex; gap:10px;">
                        <input type="number" name="obt" placeholder="Obtained" required style="width:33%">
                        <input type="number" name="tot" placeholder="Total" required style="width:33%">
                        <input type="number" name="convert_to" placeholder="Convert Max (Opt)" style="width:33%">
                    </div>
                </div>

                <div class="form-group">
                    <label>Remarks</label>
                    <input type="text" name="remarks" placeholder="Optional comments...">
                </div>

                <button type="submit" class="btn">Upload Evaluation</button>
            </form>
            {% endif %}
        </div>

        <!-- 3. Attendance Tracker (Enhanced) -->
        <div class="card">
            <h3>Mark Daily Attendance</h3>
            {% if not current_user.subject %}
            <p>No Subject Assigned</p>
            {% else %}
            <form action="{{ url_for('faculty.update_attendance') }}" method="POST">

                <div class="form-group">
                    <label>Date</label>
                    <input type="date" name="att_date" required>
                </div>

                <div class="form-group">
                    <label>Number of Slots (Hours)</label>
                    <input type="number" name="slots" value="1" min="1" max="5" required>
                </div>

                <div class="form-group">
                    <label>Select Student</label>
                    <input list="students_list" name="student_id" placeholder="Start typing name..." required>
                </div>

                <div class="form-group" style="text-align: center;">
                    <label>Status</label>
                    <div style="display:flex; justify-content:center; gap:20px; margin-top:10px;">
                        <label style="cursor:pointer;">
                            <input type="radio" name="status" value="Present" checked>
                            <span class="badge success" style="padding:10px 20px;">Present</span>
                        </label>
                        <label style="cursor:pointer;">
                            <input type="radio" name="status" value="Absent">
                            <span class="badge error" style="padding:10px 20px;">Absent</span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn" style="width:100%; margin-top:10px;">Mark Attendance</button>
            </form>
            {% endif %}
        </div>

        <!-- 4. Risk Overview (Split) -->
        <div class="card full-width">
            <h3>Student Overview & Risk Status</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>CGPA</th>
                        <th>SGPA</th>
                        <th>Att. Risk</th>
                        <th>Marks Risk</th>
                        <th>Overall Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in students %}
                    <tr>
                        <td>{{ s.id }}</td>
                        <td>{{ s.username }}</td>
                        <td>{{ s.cgpa }}</td>
                        <td>{{ s.sgpa }}</td>
                        <td>
                            <span
                                class="badge {% if s.risk_att == 'High' %}error{% elif s.risk_att == 'Medium' %}warning{% else %}success{% endif %}">
                                {{ s.risk_att }}
                            </span>
                        </td>
                        <td>
                            <span
                                class="badge {% if s.risk_marks == 'High' %}error{% elif s.risk_marks == 'Medium' %}warning{% else %}success{% endif %}">
                                {{ s.risk_marks }}
                            </span>
                        </td>
                        <td>
                            {% if s.risk == 'High' %}
                            <strong style="color:red">At Risk</strong>
                            {% else %}
                            <span style="color:green">On Track</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>

    <!-- 5. Manage Published Marks (New) -->
    <div class="card full-width">
        <h3>Manage Published Marks</h3>
        <p>Select a student to view and edit marks uploaded by you.</p>

        <!-- Selection Form -->
        <form action="{{ url_for('faculty.manage_marks') }}" method="POST" style="margin-bottom: 20px;">
            <div class="form-group" style="display:flex; gap:10px;">
                <input list="students_list" name="student_id" placeholder="Search Student..." required
                    style="flex-grow:1;">
                <button type="submit" class="btn">Fetch Records</button>
            </div>
        </form>

        <!-- Records Table (Visible if edit_records is populated) -->
        {% if edit_records %}
        <h4>Records for: {{ selected_student_name }}</h4>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Context</th>
                    <th>Current Entry</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for rec in edit_records %}
                <tr>
                    <td>
                        {% if rec.assignments %} Assignment {% else %} Evaluation {% endif %}
                    </td>
                    <td>
                        {{ rec.assignments or rec.evaluations }}
                    </td>
                    <td>
                        <!-- Simple Inline Edit Form -->
                        <form action="{{ url_for('faculty.edit_record_marks') }}" method="POST"
                            style="display:flex; gap:5px; align-items:center;">
                            <input type="hidden" name="record_id" value="{{ rec.id }}">
                            <input type="number" name="obt" placeholder="Obt" step="0.5" required style="width:60px;">
                            <input type="number" name="tot" placeholder="Tot" step="0.5" required style="width:60px;">
                            <input type="number" name="convert_to" placeholder="Conv" step="0.5" style="width:60px;">
                            <button type="submit" class="btn warning"
                                style="padding:5px 10px; font-size:0.8rem;">Update</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% elif selected_student_id %}
        <p>No records found for this student in your subject.</p>
        {% endif %}
    </div>

</div>
</div>
{% endblock %}